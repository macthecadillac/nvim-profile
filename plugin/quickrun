#!/usr/bin/env python
import subprocess
import sys
import re

# Set up the environment
fname = sys.argv[1]
curr_dir = sys.argv[2]
try:
    ext = re.search(r'(\.[\w]+\b)', fname).groups()[0]
except:
    sys.exit()

# Execute the file. Automatically chooses the correct interpreter and/or compiler.
interpreters = {
    '.py': '$HOME/anaconda3/bin/python ',
    '.jl': '$HOME/julia/bin/julia '
}

if ext in interpreters:
    script = interpreters[ext] + fname + '\n'
elif ext == '.rs':
    script = 'cargo run\n'

# Message to be displayed at the end of the job
script += 'echo "------------------------------"\n'
script += 'echo ""\n'
script += 'echo "Press RETURN to exit"\n'
script += 'read -p ""\n'

with open('/tmp/run', 'w') as cmd:
    cmd.write('#!/bin/bash\n')
    cmd.write('cd ' + curr_dir + '\n')
    cmd.writelines(script)

# print(command)
subprocess.Popen(['chmod', '+x', '/tmp/run'])
subprocess.Popen(['/usr/bin/x-terminal-emulator', '-e', '/tmp/run'])
